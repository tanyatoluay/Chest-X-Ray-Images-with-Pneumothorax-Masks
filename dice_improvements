th the following features:\n","- dropout as bottleneck to improve overfitting\n","- LeakyRelu activation function to maintain neuron activation during training\n","- weighted binary cross-entropy loss to balance classes\n","- learning reate decay by half if there is no improvment after 3 epochs\n","- "]},{"cell_type":"code","execution_count":13,"id":"0a5b647a","metadata":{"execution":{"iopub.execute_input":"2025-08-19T19:49:43.112599Z","iopub.status.busy":"2025-08-19T19:49:43.1123Z","iopub.status.idle":"2025-08-19T19:49:43.115665Z","shell.execute_reply":"2025-08-19T19:49:43.114963Z"},"papermill":{"duration":0.015037,"end_time":"2025-08-19T19:49:43.116765","exception":false,"start_time":"2025-08-19T19:49:43.101728","status":"completed"},"tags":[]},"outputs":[],"source":["#!pip install git+https://github.com/Project-MONAI/MONAI#egg=monai\n","\n","# install dependencies\n","#!pip install fire nibabel\n","#!pip install \"scikit-image>=0.19.0\""]},{"cell_type":"code","execution_count":14,"id":"2bbd8554","metadata":{"execution":{"iopub.execute_input":"2025-08-19T19:49:43.1371Z","iopub.status.busy":"2025-08-19T19:49:43.136903Z","iopub.status.idle":"2025-08-19T19:49:43.197911Z","shell.execute_reply":"2025-08-19T19:49:43.197049Z"},"papermill":{"duration":0.072458,"end_time":"2025-08-19T19:49:43.199056","exception":false,"start_time":"2025-08-19T19:49:43.126598","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Device: cuda\n"]}],"source":["# Config\n","BASE_PATH = '/kaggle/working'\n","IMG_FOLDER = 'imagesTr'\n","MASK_FOLDER = 'labelsTr'\n","RESIZE = 256 #\n","BATCH_SIZE = 12 # faster than 8\n","LR = 3e-4\n","SEED = 42\n","EPOCHS = 10 #############adjust!!!\n","w_dc = 0.3 # weight of dice loss\n","w_bce = 0.7 # weight of bce loss; we want this one to be bigger as it also weights the minority class more favourably\n","\n","# Seed\n","torch.manual_seed(SEED)\n","np.random.seed(SEED)\n","random.seed(SEED)\n","generator = torch.Generator().manual_seed(42)\n","# Device\n","DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","print(\"Device:\", DEVICE)"]},{"cell_type":"code","execution_count":15,"id":"996ebcd2","metadata":{"execution":{"iopub.execute_input":"2025-08-19T19:49:43.220313Z","iopub.status.busy":"2025-08-19T19:49:43.220099Z","iopub.status.idle":"2025-08-19T19:49:43.226896Z","shell.execute_reply":"2025-08-19T19:49:43.226109Z"},"papermill":{"duration":0.018466,"end_time":"2025-08-19T19:49:43.22801","exception":false,"start_time":"2025-08-19T19:49:43.209544","status":"completed"},"tags":[]},"outputs":[],"source":["# class for dataset loading\n","class LungCTDataset(Dataset):\n","    def __init__(self, image_dir, mask_dir, resize=RESIZE): \n","        self.image_dir = Path(image_dir)\n","        self.mask_dir = Path(mask_dir)\n","        self.files = sorted([f.name for f in self.image_dir.iterdir() if f.suffix == '.png'])\n","        tf = T.Compose([T.Resize((resize, resize)), T.ToTensor()])\n","        self.img_tf, self.mask_tf = tf, tf\n","\n","    def __len__(self):\n","        return len(self.files)\n","\n","    def __getitem__(self, idx):\n","        img_name = self.files[idx]\n","        mask_name = img_name.replace('__0000.png', '_.png')\n","        img = Image.open(self.image_dir / img_name).convert('L')\n","        mask = Image.open(self.mask_dir / mask_name).convert('L')\n","        img, mask = self.img_tf(img), self.mask_tf(mask)\n","        return img, (mask > 0).float()"]},{"cell_type":"code","execution_count":16,"id":"755efb78","metadata":{"execution":{"iopub.execute_input":"2025-08-19T19:49:43.248628Z","iopub.status.busy":"2025-08-19T19:49:43.248405Z","iopub.status.idle":"2025-08-19T19:49:43.260255Z","shell.execute_reply":"2025-08-19T19:49:43.259766Z"},"papermill":{"duration":0.023436,"end_time":"2025-08-19T19:49:43.261283","exception":false,"start_time":"2025-08-19T19:49:43.237847","status":"completed"},"tags":[]},"outputs":[],"source":["\n","class UNet(nn.Module):\n","    def __init__(self, in_channels, num_classes):\n","        super().__init__()\n","        self.dc1 = DownSample(in_channels, 64)\n","        self.dc2 = DownSample(64, 128)\n","        self.dc3 = DownSample(128, 256)\n","        self.dc4 = DownSample(256, 512)\n","\n","        self.bn = nn.Sequential( # bottleneck, hopefully helping with overfitting\n","            DoubleConv(512, 1024),\n","            nn.Dropout(0.5) \n","        )\n","\n","        self.uc1 = UpSample(1024, 512)\n","        self.uc2 = UpSample(512, 256)\n","        self.uc3 = UpSample(256, 128)\n","        self.uc4 = UpSample(128, 64)\n","\n","        self.out = nn.Conv2d(in_channels=64, out_channels=num_classes, kernel_size=1)\n","\n","    def forward(self, x):\n","       down_1, p1 = self.dc1(x)\n","       down_2, p2 = self.dc2(p1)\n","       down_3, p3 = self.dc3(p2)\n","       down_4, p4 = self.dc4(p3)\n","\n","       b = self.bn(p4) # bottleneck\n","\n","       up_1 = self.uc1(b, down_4)\n","       up_2 = self.uc2(up_1, down_3)\n","       up_3 = self.uc3(up_2, down_2)\n","       up_4 = self.uc4(up_3, down_1)\n","\n","       out = self.out(up_4)\n","       return out\n","\n","\n","class DoubleConv(nn.Module):\n","    def __init__(self, in_channels, out_channels, dropout=0.5):\n","        super().__init__()\n","        self.conv_op = nn.Sequential(\n","            nn.Conv2d(in_channels, out_channels, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(out_channels),\n","            nn.LeakyReLU(inplace=True), # to improve learning, ReLu had a big gap between validation loss and training loss\n","            nn.Dropout2d(p=dropout), # bottleneck, trying to help with overfitting\n","            \n","            nn.Conv2d(out_channels, out_channels, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(out_channels),\n","            nn.LeakyReLU(inplace=True) #ReLU\n","        )\n","\n","    def forward(self, x):\n","        return self.conv_op(x)\n","\n","class DownSample(nn.Module):\n","    def __init__(self, in_channels, out_channels):\n","        super().__init__()\n","        self.pool = nn.MaxPool2d(kernel_size=2, stride=2)\n","        self.conv = DoubleConv(in_channels, out_channels)\n","        \n","\n","    def forward(self, x):\n","        down = self.conv(x)\n","        p = self.pool(down)\n","        return down, p\n","\n","class UpSample(nn.Module):\n","    def __init__(self, in_channels, out_channels):\n","        super().__init__()\n","        self.up = nn.ConvTranspose2d(in_channels, out_channels, kernel_size=2, stride=2)\n","        self.conv = DoubleConv(in_channels=out_channels*2, out_channels=out_channels)\n","\n","    def forward(self, y1, y2):\n","        y1 = self.up(y1)\n","        # making sure sizes match\n","        diff_1 = y2.size()[2] - y1.size()[2]\n","        diff_2 = y2.size()[3] - y1.size()[3]\n","        y1 = F.pad(y1, [diff_1 // 2, diff_1 - diff_1 // 2, diff_2 // 2, diff_2 - diff_2 // 2]) # padding if sized do not match\n","        y = torch.cat([y1, y2], dim = 1)\n","        return self.conv(y)"]},{"cell_type":"code","execution_count":17,"id":"63acfd95","metadata":{"execution":{"iopub.execute_input":"2025-08-19T19:49:43.281843Z","iopub.status.busy":"2025-08-19T19:49:43.281669Z","iopub.status.idle":"2025-08-19T19:49:43.285687Z","shell.execute_reply":"2025-08-19T19:49:43.285005Z"},"papermill":{"duration":0.01595,"end_time":"2025-08-19T19:49:43.286921","exception":false,"start_time":"2025-08-19T19:49:43.270971","status":"completed"},"tags":[]},"outputs":[],"source":["def dice_coefficient(p, t, threshold, epsilon=1e-07): ##################\n","    p_copy = p.clone()\n","    p_copy[p_copy < threshold] = 0\n","    p_copy[p_copy > threshold] = 1\n","    intersection = abs(torch.sum(p_copy * t))\n","    union = abs(torch.sum(p_copy) + torch.sum(t))\n","    dice = (2 * intersection + epsilon) / (union + epsilon)\n","    return dice"]},{"cell_type":"code","execution_count":18,"id":"1762ce33","metadata":{"execution":{"iopub.execute_input":"2025-08-19T19:49:43.307458Z","iopub.status.busy":"2025-08-19T19:49:43.307266Z","iopub.status.idle":"2025-08-19T19:49:43.3121Z","shell.execute_reply":"2025-08-19T19:49:43.311529Z"},"papermill":{"duration":0.016402,"end_time":"2025-08-19T19:49:43.313085","exception":false,"start_time":"2025-08-19T19:49:43.296683","status":"completed"},"tags":[]},"outputs":[],"source":["def find_best_threshold(model, val_loader, device):\n","    thresholds=np.linspace(0.1, 0.9, 9)\n","    print(thresholds)\n","    model.eval()\n","    best_t, best_dice = 0.0, 0.0 # from best_t 0.5 to ee if it actually overwrites anything\n","    with torch.no_grad():\n","        for t in thresholds:\n","            dices = []\n","            for imgs, masks in val_loader:\n","                imgs, masks = imgs.to(device), masks.to(device)\n","                preds = model(imgs)\n","                dice = dice_coefficient(torch.sigmoid(preds), masks, threshold = t).item()\n","                dices.append(dice)\n","            mean_dice = np.mean(dices)\n","            print(f\"Current threshold: {t:.2f} with mean Dice {mean_dice:.4f}\")\n","            if mean_dice > best_dice:\n","                best_dice, best_t = mean_dice, t\n","\n","    print(f\"Best threshold: {best_t:.2f} with Dice {best_dice:.4f}\")\n","    return best_t"]},{"cell_type":"code","execution_count":19,"id":"8cff97f0","metadata":{"execution":{"iopub.execute_input":"2025-08-19T19:49:43.333899Z","iopub.status.busy":"2025-08-19T19:49:43.33343Z","iopub.status.idle":"2025-08-19T19:49:43.33862Z","shell.execute_reply":"2025-08-19T19:49:43.338125Z"},"papermill":{"duration":0.016757,"end_time":"2025-08-19T19:49:43.33967","exception":false,"start_time":"2025-08-19T19:49:43.322913","status":"completed"},"tags":[]},"outputs":[],"source":["## Calculate Dice loss and weighted sum of Diace and BCE loss \n","class DiceLoss(nn.Module):\n","    def __init__(self, smooth=1.0):\n","        super().__init__()\n","        self.smooth = smooth\n","\n","    def forward(self, p, t):\n","        p = p.view(-1)\n","        t = t.view(-1)\n","        intersection = (p * t).sum()\n","        return 1 - (2 * intersection + self.smooth) / (p.sum() + t.sum() + self.smooth)\n","\n","class CombinedLoss(nn.Module):\n","    def __init__(self, dice_weight=w_dc, bce_weight=w_bce):\n","        super().__init__()\n","        self.dice = DiceLoss()\n","        self.bce = nn.BCEWithLogitsLoss(pos_weight=torch.tensor([5.0]).to(DEVICE)) ### weights for minority class\n","        self.dw = dice_weight\n","        self.bw = bce_weight\n","\n","    def forward(self, p, t):\n","        return self.dw * self.dice(p, t) + self.bw * self.bce(p, t)"]},{"cell_type":"code","execution_count":20,"id":"5e4e372b","metadata":{"execution":{"iopub.execute_input":"2025-08-19T19:49:43.360215Z","iopub.status.busy":"2025-08-19T19:49:43.360029Z","iopub.status.idle":"2025-08-19T19:49:43.364005Z","shell.execute_reply":"2025-08-19T19:49:43.36339Z"},"papermill":{"duration":0.015724,"end_time":"2025-08-19T19:49:43.365136","exception":false,"start_time":"2025-08-19T19:49:43.349412","status":"completed"},"tags":[]},"outputs":[],"source":["def iou_coefficient(p, t, epsilon=1e-8):\n","    p_copy = p.clone()\n","\n","    p_copy[p_copy  < 0.5] = 0\n","    p_copy[p_copy  > 0.5] = 1\n","\n","    intersection = abs(torch.sum(p_copy * t))\n","    union = abs(torch.sum(p_copy) + torch.sum(t))\n","    iou = (intersection + epsilon) / ((union + epsilon)-intersection)\n","    \n","    return iou"]},{"cell_type":"code","execution_count":21,"id":"8d1bdac9","metadata":{"execution":{"iopub.execute_input":"2025-08-19T19:49:43.385971Z","iopub.status.busy":"2025-08-19T19:49:43.385773Z","iopub.status.idle":"2025-08-19T19:49:43.390035Z","shell.execute_reply":"2025-08-19T19:49:43.389526Z"},"papermill":{"duration":0.015975,"end_time":"2025-08-19T19:49:43.391031","exception":false,"start_time":"2025-08-19T19:49:43.375056","status":"completed"},"tags":[]},"outputs":[],"source":["def compute_classification_metrics(pred, target, epsilon=1e-07):\n","    pred_bin = (pred >= 0.5).float()\n","    y_true = target.detach().cpu().numpy().flatten()\n","    y_pred = pred_bin.detach().cpu().numpy().flatten()\n","    tn, fp, fn, tp = confusion_matrix(\n","        y_true.flatten(), y_pred.flatten(), labels=[0,1]\n","    ).ravel()\n","    sensitivity = tp / (tp + fn + epsilon)\n","    specificity = tn / (tn + fp + epsilon)\n","    precision   = tp / (tp + fp + epsilon)\n","    return sensitivity, specificity, precision"]},{"cell_type":"code","execution_count":22,"id":"bbf39b64","metadata":{"execution":{"iopub.execute_input":"2025-08-19T19:49:43.41232Z","iopub.status.busy":"2025-08-19T19:49:43.411715Z","iopub.status.idle":"2025-08-19T19:49:43.417472Z","shell.execute_reply":"2025-08-19T19:49:43.416766Z"},"papermill":{"duration":0.017601,"end_time":"2025-08-19T19:49:43.41853","exception":false,"start_time":"2025-08-19T19:49:43.400929","status":"completed"},"tags":[]},"outputs":[],"source":["def eval_epoch_with_metrics(model, loader, criterion, device, bdt):\n","    model.eval()\n","    total_loss = 0\n","    total_dice = 0\n","    total_iou = 0\n","    total_sens = 0\n","    total_sepc = 0\n","    total_prec = 0\n","\n","    all_preds = []\n","    all_labels = []\n","\n","    with torch.no_grad():\n","        for X, y in loader:\n","            X, y = X.to(device), y.to(device)\n","            pred = model(X)\n","            total_loss += criterion(pred, y).item()\n","            total_dice += dice_coefficient(pred, y, bdt).item()\n","            total_iou += iou_coefficient(pred, y).item()\n","            sensitivity_temp, specificity_temp, precision_temp = compute_classification_metrics(pred, y)\n","            print(specificity_temp)\n","            total_sens += sensitivity_temp\n","            total_sepc += specificity_temp\n","            total_prec += precision_temp\n","\n","            # Save predictions and labels for AUC calculation later\n","            all_preds.extend(pred.view(-1).cpu().numpy())\n","            all_labels.extend(y.view(-1).cpu().numpy())\n","\n","    # Calculate pixel-wise ROC AUC\n","    from sklearn.metrics import roc_auc_score\n","    auc = roc_auc_score(all_labels, all_preds)\n","\n","    n = len(loader)\n","    return total_loss / n, total_dice / n, total_iou / n, auc, total_sens / n, total_sepc / n, total_prec / n"]},{"cell_type":"code","execution_count":23,"id":"3ba328b6","metadata":{"execution":{"iopub.execute_input":"2025-08-19T19:49:43.438797Z","iopub.status.busy":"2025-08-19T19:49:43.438601Z","iopub.status.idle":"2025-08-19T19:49:43.442691Z","shell.execute_reply":"2025-08-19T19:49:43.442187Z"},"papermill":{"duration":0.015433,"end_time":"2025-08-19T19:49:43.443776","exception":false,"start_time":"2025-08-19T19:49:43.428343","status":"completed"},"tags":[]},"outputs":[],"source":["def train_epoch(model, loader, criterion, optimizer, device):\n","    model.train()\n","    total = 0\n","    for X, y in tqdm(loader, desc=\"Train\", leave=False):\n","        X, y = X.to(device), y.to(device)\n","        pred = model(X)\n","        loss = criterion(pred, y)\n","        optimizer.zero_grad()\n","        loss.backward()\n","        optimizer.step()\n","        total += loss.item()\n","    return total / len(loader)\n","\n","\n","# are we using this???\n","#def eval_epoch(model, loader, criterion, device, bdt):\n","   # model.eval()\n","   # total_loss = 0\n","   # total_dice = 0\n","   # with torch.no_grad():\n","       # for X, y in loader:                \n","         #   X, y = X.to(device), y.to(device)\n","         #   pred = model(X)\n","          #  total_loss += criterion(pred, y).item()\n","\n","          #  dice += dice_coefficient(pred, y, bdt).item()\n","          #  print(f\"Threshold {th:.2f}: Dice {dice:.4f}\")\n","  #  return total_loss / len(loader), total_dice / len(loader)"]},{"cell_type":"code","execution_count":24,"id":"60631f5f","metadata":