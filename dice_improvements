ecarlo dropout","metadata":{}},{"cell_type":"code","source":"def mc_dropout_predict(model, dataset, device, num, n_samples = 20, threshold = 0.5):\n    model.train()  # keep dropout layers active\n    \n    # freeze BatchNorm stats\n    for m in model.modules():\n        if isinstance(m, nn.BatchNorm2d):\n            m.eval()\n    for i in range(num):\n        if i >= len(dataset)-1:\n            break\n        preds = []\n        img, true_mask = dataset[i]\n        img_tensor = img.unsqueeze(0).to(device)\n        with torch.no_grad():\n            for j in range(n_samples):\n                out = torch.sigmoid(model(img_tensor.to(device)))\n                preds.append(out.cpu().numpy())\n        \n        preds = np.stack(preds)  # shape: (n_samples, B, C, H, W)\n        mean_pred = preds.mean(axis=0)\n        std_pred  = preds.std(axis=0)\n        binary_mask = (mean_pred >= threshold).astype(np.uint8)\n\n        plt.subplot(2,2,1)\n        plt.imshow(img.squeeze().cpu(), cmap=\"gray\")\n        plt.title(\"Input\")\n        \n        plt.subplot(2,2,2)\n        plt.imshow(true_mask.squeeze().cpu(), cmap=\"gray\")\n        plt.title(\"Ground Truth\")\n        \n        plt.subplot(2,2,3)\n        plt.imshow(mean_pred[0,0], cmap=\"jet\")\n        plt.title(\"MC Dropout mean\")\n\n        plt.subplot(2,2,4)\n        plt.imshow(std_pred[0,0], cmap=\"hot\")\n        plt.title(\"Uncertainty\")\n        plt.show()\n\nmc_dropout_predict(model, test_ds, DEVICE, num=25)","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}