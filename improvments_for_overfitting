ilable() else 'cpu')\n","print(\"Device:\", DEVICE)"]},{"cell_type":"code","execution_count":15,"id":"56b41a56","metadata":{"execution":{"iopub.execute_input":"2025-08-16T05:55:11.718102Z","iopub.status.busy":"2025-08-16T05:55:11.717883Z","iopub.status.idle":"2025-08-16T05:55:11.72434Z","shell.execute_reply":"2025-08-16T05:55:11.723768Z"},"papermill":{"duration":0.017171,"end_time":"2025-08-16T05:55:11.725391","exception":false,"start_time":"2025-08-16T05:55:11.70822","status":"completed"},"tags":[]},"outputs":[],"source":["# class for dataset loading\n","class LungCTDataset(Dataset):\n","    def __init__(self, image_dir, mask_dir, resize=RESIZE): \n","        self.image_dir = Path(image_dir)\n","        self.mask_dir = Path(mask_dir)\n","        self.files = sorted([f.name for f in self.image_dir.iterdir() if f.suffix == '.png'])\n","        tf = T.Compose([T.Resize((resize, resize)), T.ToTensor()])\n","        self.img_tf, self.mask_tf = tf, tf\n","\n","    def __len__(self):\n","        return len(self.files)\n","\n","    def __getitem__(self, idx):\n","        img_name = self.files[idx]\n","        mask_name = img_name.replace('__0000.png', '_.png')\n","        img = Image.open(self.image_dir / img_name).convert('L')\n","        mask = Image.open(self.mask_dir / mask_name).convert('L')\n","        img, mask = self.img_tf(img), self.mask_tf(mask)\n","        return img, (mask > 0).float()"]},{"cell_type":"code","execution_count":16,"id":"0dbbb9ca","metadata":{"execution":{"iopub.execute_input":"2025-08-16T05:55:11.743817Z","iopub.status.busy":"2025-08-16T05:55:11.743607Z","iopub.status.idle":"2025-08-16T05:55:11.754069Z","shell.execute_reply":"2025-08-16T05:55:11.753392Z"},"papermill":{"duration":0.02104,"end_time":"2025-08-16T05:55:11.755218","exception":false,"start_time":"2025-08-16T05:55:11.734178","status":"completed"},"tags":[]},"outputs":[],"source":["\n","class UNet(nn.Module):\n","    def __init__(self, in_channels, num_classes):\n","        super().__init__()\n","        self.dc1 = DownSample(in_channels, 64)\n","        self.dc2 = DownSample(64, 128)\n","        self.dc3 = DownSample(128, 256)\n","        self.dc4 = DownSample(256, 512)\n","\n","        self.bn = nn.Sequential( # bottleneck, hopefully helping with overfitting\n","            DoubleConv(512, 1024),\n","            nn.Dropout(0.5) \n","        )\n","\n","        self.uc1 = UpSample(1024, 512)\n","        self.uc2 = UpSample(512, 256)\n","        self.uc3 = UpSample(256, 128)\n","        self.uc4 = UpSample(128, 64)\n","\n","        self.out = nn.Conv2d(in_channels=64, out_channels=num_classes, kernel_size=1)\n","\n","    def forward(self, x):\n","       down_1, p1 = self.dc1(x)\n","       down_2, p2 = self.dc2(p1)\n","       down_3, p3 = self.dc3(p2)\n","       down_4, p4 = self.dc4(p3)\n","\n","       b = self.bn(p4) # bottleneck\n","\n","       up_1 = self.uc1(b, down_4)\n","       up_2 = self.uc2(up_1, down_3)\n","       up_3 = self.uc3(up_2, down_2)\n","       up_4 = self.uc4(up_3, down_1)\n","\n","       out = self.out(up_4)\n","       return out\n","\n","\n","class DoubleConv(nn.Module):\n","    def __init__(self, in_channels, out_channels, dropout=0.5):\n","        super().__init__()\n","        self.conv_op = nn.Sequential(\n","            nn.Conv2d(in_channels, out_channels, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(out_channels),\n","            nn.LeakyReLU(inplace=True), # to improve learning, ReLu had a big gap between validation loss and training loss\n","            nn.Dropout2d(p=dropout), # bottleneck, trying to help with overfitting\n","            \n","            nn.Conv2d(out_channels, out_channels, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(out_channels),\n","            nn.LeakyReLU(inplace=True) #ReLU\n","        )\n","\n","    def forward(self, x):\n","        return self.conv_op(x)\n","\n","class DownSample(nn.Module):\n","    def __init__(self, in_channels, out_channels):\n","        super().__init__()\n","        self.pool = nn.MaxPool2d(kernel_size=2, stride=2)\n","        self.conv = DoubleConv(in_channels, out_channels)\n","        \n","\n","    def forward(self, x):\n","        down = self.conv(x)\n","        p = self.pool(down)\n","        return down, p\n","\n","class UpSample(nn.Module):\n","    def __init__(self, in_channels, out_channels):\n","        super().__init__()\n","        self.up = nn.ConvTranspose2d(in_channels, out_channels, kernel_size=2, stride=2)\n","        self.conv = DoubleConv(in_channels=out_channels*2, out_channels=out_channels)\n","\n","    def forward(self, y1, y2):\n","        y1 = self.up(y1)\n","        # making sure sizes match\n","        diff_1 = y2.size()[2] - y1.size()[2]\n","        diff_2 = y2.size()[3] - y1.size()[3]\n","        y1 = F.pad(y1, [diff_1 // 2, diff_1 - diff_1 // 2, diff_2 // 2, diff_2 - diff_2 // 2]) # padding if sized do not match\n","        y = torch.cat([y1, y2], dim = 1)\n","        return self.conv(y)"]},{"cell_type":"code","execution_count":17,"id":"ebd68fcc","metadata":{"execution":{"iopub.execute_input":"2025-08-16T05:55:11.773839Z","iopub.status.busy":"2025-08-16T05:55:11.773634Z","iopub.status.idle":"2025-08-16T05:55:11.780055Z","shell.execute_reply":"2025-08-16T05:55:11.779383Z"},"papermill":{"duration":0.017189,"end_time":"2025-08-16T05:55:11.781221","exception":false,"start_time":"2025-08-16T05:55:11.764032","status":"completed"},"tags":[]},"outputs":[],"source":["def dice_coefficient(p, t, epsilon=1e-07): \n","    p_copy = p.clone()\n","    p_copy[p_copy < 0.5] = 0\n","    p_copy[p_copy > 0.5] = 1\n","    intersection = abs(torch.sum(p_copy * t))\n","    union = abs(torch.sum(p_copy) + torch.sum(t))\n","    dice = (2 * intersection + epsilon) / (union + epsilon)\n","    return dice\n","\n","\n","\n","class DiceLoss(nn.Module):\n","    def __init__(self, smooth=1.0):\n","        super().__init__()\n","        self.smooth = smooth\n","\n","    def forward(self, p, t):\n","        p = p.view(-1)\n","        t = t.view(-1)\n","        intersection = (p * t).sum()\n","        return 1 - (2 * intersection + self.smooth) / (p.sum() + t.sum() + self.smooth)\n","\n","class CombinedLoss(nn.Module):\n","    def __init__(self, dice_weight=w_dc, bce_weight=w_bce):\n","        super().__init__()\n","        self.dice = DiceLoss()\n","        self.bce = nn.BCEWithLogitsLoss(pos_weight=torch.tensor([5.0]).to(DEVICE)) ### weights for minority class\n","        self.dw = dice_weight\n","        self.bw = bce_weight\n","\n","    def forward(self, p, t):\n","        return self.dw * self.dice(p, t) + self.bw * self.bce(p, t)"]},{"cell_type":"code","execution_count":18,"id":"5f919fa3","metadata":{"execution":{"iopub.execute_input":"2025-08-16T05:55:11.799049Z","iopub.status.busy":"2025-08-16T05:55:11.798848Z","iopub.status.idle":"2025-08-16T05:55:11.802544Z","shell.execute_reply":"2025-08-16T05:55:11.802037Z"},"papermill":{"duration":0.01374,"end_time":"2025-08-16T05:55:11.803614","exception":false,"start_time":"2025-08-16T05:55:11.789874","status":"completed"},"tags":[]},"outputs":[],"source":["def iou_coefficient(p, t, epsilon=1e-8):\n","    p_copy = p.clone()\n","\n","    p_copy[p_copy  < 0.5] = 0\n","    p_copy[p_copy  > 0.5] = 1\n","\n","    intersection = abs(torch.sum(p_copy * t))\n","    union = abs(torch.sum(p_copy) + torch.sum(t))\n","    iou = (intersection + epsilon) / ((union + epsilon)-intersection)\n","    \n","    return iou"]},{"cell_type":"code","execution_count":19,"id":"2b8c5e34","metadata":{"execution":{"iopub.execute_input":"2025-08-16T05:55:11.821785Z","iopub.status.busy":"2025-08-16T05:55:11.82159Z","iopub.status.idle":"2025-08-16T05:55:11.826562Z","shell.execute_reply":"2025-08-16T05:55:11.825911Z"},"papermill":{"duration":0.015056,"end_time":"2025-08-16T05:55:11.827517","exception":false,"start_time":"2025-08-16T05:55:11.812461","status":"completed"},"tags":[]},"outputs":[],"source":["def eval_epoch_with_metrics(model, loader, criterion, device):\n","    model.eval()\n","    total_loss = 0\n","    total_dice = 0\n","    total_iou = 0\n","\n","    all_preds = []\n","    all_labels = []\n","\n","    with torch.no_grad():\n","        for X, y in loader:\n","            X, y = X.to(device), y.to(device)\n","            pred = model(X)\n","            total_loss += criterion(pred, y).item()\n","            total_dice += dice_coefficient(pred, y).item()\n","            total_iou += iou_coefficient(pred, y).item()\n","\n","            # Save predictions and labels for AUC calculation later\n","            all_preds.extend(pred.view(-1).cpu().numpy())\n","            all_labels.extend(y.view(-1).cpu().numpy())\n","\n","    # Calculate pixel-wise ROC AUC\n","    from sklearn.metrics import roc_auc_score\n","    auc = roc_auc_score(all_labels, all_preds)\n","\n","    n = len(loader)\n","    return total_loss / n, total_dice / n, total_iou / n, auc"]},{"cell_type":"code","execution_count":20,"id":"225336aa","metadata":{"execution":{"iopub.execute_input":"2025-08-16T05:55:11.846078Z","iopub.status.busy":"2025-08-16T05:55:11.845882Z","iopub.status.idle":"2025-08-16T05:55:11.850951Z","shell.execute_reply":"2025-08-16T05:55:11.850465Z"},"papermill":{"duration":0.01573,"end_time":"2025-08-16T05:55:11.851876","exception":false,"start_time":"2025-08-16T05:55:11.836146","status":"completed"},"tags":[]},"outputs":[],"source":["def train_epoch(model, loader, criterion, optimizer, device):\n","    model.train()\n","    total = 0\n","    for X, y in tqdm(loader, desc=\"Train\", leave=False):\n","        X, y = X.to(device), y.to(device)\n","        pred = model(X)\n","        loss = criterion(pred, y)\n","        optimizer.zero_grad()\n","        loss.backward()\n","        optimizer.step()\n","        total += loss.item()\n","    return total / len(loader)\n","\n","def eval_epoch(model, loader, criterion, device):\n","    model.eval()\n","    total_loss = 0\n","    total_dice = 0\n","    with torch.no_grad():\n","     