on":{"iopub.execute_input":"2025-08-24T16:30:44.76476Z","iopub.status.busy":"2025-08-24T16:30:44.764471Z","iopub.status.idle":"2025-08-24T16:30:44.77028Z","shell.execute_reply":"2025-08-24T16:30:44.769476Z"},"papermill":{"duration":0.017708,"end_time":"2025-08-24T16:30:44.77145","exception":false,"start_time":"2025-08-24T16:30:44.753742","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Writing convert_masks.sh\n"]}],"source":["%%writefile convert_masks.sh\n","#!/bin/bash\n","\n","INPUT_DIR=\"$1\"\n","OUTPUT_DIR=\"$2\"\n","\n","if [[ -z \"$INPUT_DIR\" || -z \"$OUTPUT_DIR\" ]]; then\n","  echo \"Usage: $0 /path/to/input_dir /path/to/output_dir\"\n","  exit 1\n","fi\n","\n","mkdir -p \"$OUTPUT_DIR\"\n","\n","for FILE in \"$INPUT_DIR\"/*.png; do\n","  BASENAME=$(basename \"$FILE\")\n","  OUTPUT_FILE=\"$OUTPUT_DIR/$BASENAME\"\n","\n","  convert \"$FILE\" -depth 8 -type Grayscale \\\n","    -fx 'i==255 ? 1 : 0' \"$OUTPUT_FILE\"\n","done\n","\n","echo \"Conversion complete. Output saved in $OUTPUT_DIR.\"\n","\n","!bash convert_masks.sh labelsTr labelsTr_converted"]},{"cell_type":"code","execution_count":10,"id":"a401dc87","metadata":{"execution":{"iopub.execute_input":"2025-08-24T16:30:44.791851Z","iopub.status.busy":"2025-08-24T16:30:44.791603Z","iopub.status.idle":"2025-08-24T16:32:54.017922Z","shell.execute_reply":"2025-08-24T16:32:54.01712Z"},"papermill":{"duration":129.248086,"end_time":"2025-08-24T16:32:54.029361","exception":false,"start_time":"2025-08-24T16:30:44.781275","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Mask conversion done!\n"]}],"source":["\n","input_dir = 'labelsTr'           # folder with original masks (created by your rename_link_masks.sh)\n","output_dir = 'labelsTr_converted'  # output folder for converted masks\n","\n","os.makedirs(output_dir, exist_ok=True)\n","\n","for filename in os.listdir(input_dir):\n","    if filename.endswith('.png'):\n","        mask_path = os.path.join(input_dir, filename)\n","        mask = Image.open(mask_path).convert('L')  # convert to grayscale\n","        \n","        mask_np = np.array(mask)\n","        # Convert 255 -> 1, keep 0 -> 0\n","        mask_np = (mask_np == 255).astype(np.uint8)\n","        \n","        out_path = os.path.join(output_dir, filename)\n","        Image.fromarray(mask_np).save(out_path)\n","\n","print(\"Mask conversion done!\")"]},{"cell_type":"markdown","id":"d6c20611","metadata":{"papermill":{"duration":0.00988,"end_time":"2025-08-24T16:32:54.049547","exception":false,"start_time":"2025-08-24T16:32:54.039667","status":"completed"},"tags":[]},"source":["After running this above code, your output directory should look like this:\n","\n","/kaggle/working/\n","\n","├── convert_masks.sh\n","\n","├── imagesTr/                 ← Training images\n","\n","├── imagesTs/                 ← Test images\n","\n","├── labelsTr/                 ← Original training masks\n","\n","├── labelsTr_converted/      ← Converted/renamed training masks\n","\n","├── labelsTs/                ← Test masks\n","\n","├── rename_link.sh\n","\n","├── rename_link_masks.sh"]},{"cell_type":"markdown","id":"06e83c6c","metadata":{"papermill":{"duration":0.009764,"end_time":"2025-08-24T16:32:54.069806","exception":false,"start_time":"2025-08-24T16:32:54.060042","status":"completed"},"tags":[]},"source":["-----------------------------------------\n","\n","## Methodology\n","\n","### Tackle class imbalance via weighted loss\n","\n","We are trying two approaches to balance the given dataset. Approach one is downsampling (see Model 1 implemented by Tanya). This model/notebook holds the second version with a weighted loss approach implemented by Julia.\n","The Weights are given to the binary cross-entropy loss (BCEWithLogitsLoss) function to give a higher value to the minority class (in our case the images labled to no not show pneumothorax)."]},{"cell_type":"markdown","id":"3a5eaad0","metadata":{"papermill":{"duration":0.009682,"end_time":"2025-08-24T16:32:54.089422","exception":false,"start_time":"2025-08-24T16:32:54.07974","status":"completed"},"tags":[]},"source":["## Model"]},{"cell_type":"markdown","id":"9d2967f0","metadata":{"papermill":{"duration":0.009489,"end_time":"2025-08-24T16:32:54.108769","exception":false,"start_time":"2025-08-24T16:32:54.09928","status":"completed"},"tags":[]},"source":["We are implementing a U-Net model with the following features:\n","- dropout as bottleneck to improve overfitting\n","- LeakyRelu activation function to maintain neuron activation during training\n","- weighted binary cross-entropy loss to balance classes\n","- learning reate decay used by our AdamW optimizer\n","- weighted sum of BCE and Dice as overal loss function\n","  "]},{"cell_type":"code","execution_count":11,"id":"8c942f73","metadata":{"execution":{"iopub.execute_input":"2025-08-24T16:32:54.129871Z","iopub.status.busy":"2025-08-24T16:32:54.129586Z","iopub.status.idle":"2025-08-24T16:32:54.189372Z","shell.execute_reply":"2025-08-24T16:32:54.188527Z"},"papermill":{"duration":0.071798,"end_time":"2025-08-24T16:32:54.190563","exception":false,"start_time":"2025-08-24T16:32:54.118765","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Device: cuda\n"]}],"source":["# Config\n","BASE_PATH = '/kaggle/working'\n","IMG_FOLDER = 'imagesTr'\n","MASK_FOLDER = 'labelsTr'\n","RESIZE = 256 # image size\n","BATCH_SIZE = 12 # faster than 8\n","LR = 3e-4\n","SEED = 42\n","EPOCHS = 20 # 100\n","w_dc = 0.3 # weight of dice loss\n","w_bce = 0.7 # weight of bce loss; we want this one to be bigger as it also weights the minority class more favourably\n","\n","# Seed\n","torch.manual_seed(SEED)\n","np.random.seed(SEED)\n","random.seed(SEED)\n","generator = torch.Generator().manual_seed(42)\n","# Device\n","DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","print(\"Device:\", DEVICE)"]},{"cell_type":"code","execution_count":12,"id":"e76e10d8","metadata":{"execution":{"iopub.execute_input":"2025-08-24T16:32:54.261564Z","iopub.status.busy":"2025-08-24T16:32:54.261282Z","iopub.status.idle":"2025-08-24T16:32:54.267562Z","shell.execute_reply":"2025-08-24T16:32:54.267016Z"},"papermill":{"duration":0.018519,"end_time":"2025-08-24T16:32:54.268652","exception":false,"start_time":"2025-08-24T16:32:54.250133","status":"completed"},"tags":[]},"outputs":[],"source":["# class for dataset loading\n","class LungCTDataset(Dataset):\n","    def __init__(self, image_dir, mask_dir, resize=RESIZE): \n","        self.image_dir = Path(image_dir)\n","        self.mask_dir = Path(mask_dir)\n","        self.files = sorted([f.name for f in self.image_dir.iterdir() if f.suffix == '.png'])\n","        tf = T.Compose([T.Resize((resize, resize)), T.ToTensor()])\n","        self.img_tf, self.mask_tf = tf, tf\n","\n","    def __len__(self):\n","        return len(self.files)\n","\n","    def __getitem__(self, idx):\n","        img_name = self.files[idx]\n","        mask_name = img_name.replace('__0000.png', '_.png')\n","        img = Image.open(self.image_dir / img_name).convert('L')\n","        mask = Image.open(self.mask_dir / mask_name).convert('L')\n","        img, mask = self.img_tf(img), self.mask_tf(mask)\n","        return img, (mask > 0).float()"]},{"cell_type":"code","execution_count":13,"id":"f0d87b79","metadata":{"execution":{"iopub.execute_input":"2025-08-24T16:32:54.289417Z","iopub.status.busy":"2025-08-24T16:32:54.289207Z","iopub.status.idle":"2025-08-24T16:32:54.299746Z","shell.execute_reply":"2025-08-24T16:32:54.299211Z"},"papermill":{"duration":0.022309,"end_time":"2025-08-24T16:32:54.300883","exception":false,"start_time":"2025-08-24T16:32:54.278574","status":"completed"},"tags":[]},"outputs":[],"source":["# class of our U-Net model\n","class UNet(nn.Module):\n","    def __init__(self, in_channels, num_classes):\n","        super().__init__()\n","        self.dc1 = DownSample(in_channels, 64)\n","        self.dc2 = DownSample(64, 128)\n","        self.dc3 = DownSample(128, 256)\n","        self.dc4 = DownSample(256, 512)\n","\n","        self.bn = nn.Sequential( # bottleneck, hopefully helping with overfitting\n","            DoubleConv(512, 1024),\n","            nn.Dropout(0.5) \n","        )\n","\n","        self.uc1 = UpSample(1024, 512)\n","        self.uc2 = UpSample(512, 256)\n","        self.uc3 = UpSample(256, 128)\n","        self.uc4 = UpSample(128, 64)\n","\n","        self.out = nn.Conv2d(in_channels=64, out_channels=num_classes, kernel_size=1)\n","\n","    def forward(self, x): \n","       down_1, p1 = self.dc1(x)\n","       down_2, p2 = self.dc2(p1)\n","       down_3, p3 = self.dc3(p2)\n","       down_4, p4 = self.dc4(p3)\n","\n","       b = self.bn(p4) # bottleneck\n","\n","       up_1 = self.uc1(b, down_4)\n","       up_2 = self.uc2(up_1, down_3)\n","       up_3 = self.uc3(up_2, down_2)\n","       up_4 = self.uc4(up_3, down_1)\n","\n","       out = self.out(up_4)\n","       return out\n","\n","\n","class DoubleConv(nn.Module):\n","    def __init__(self, in_channels, out_channels, dropout=0.5):\n","        super().__init__()\n","        self.conv_op = nn.Sequential(\n","            nn.Conv2d(in_channels, out_channels, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(out_channels),\n","            nn.LeakyReLU(inplace=True), # to improve learning, ReLu had a big gap between validation loss and training loss\n","            nn.Dropout2d(p=dropout), # bottleneck, trying to help with overfitting\n","            \n","            nn.Conv2d(out_channels, out_channels, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(out_channels),\n","            nn.LeakyReLU(inplace=True) #ReLU\n","        )\n","\n","    def forward(self, x):\n","        return self.conv_op(x)\n","\n","class DownSample(nn.Module):\n","    def __init__(self, in_channels, out_channels):\n","        super().__init__()\n","        self.pool = nn.MaxPool2d(kernel_size=2, stride=2)\n","        self.conv = DoubleConv(in_channels, out_channels)\n","        \n","\n","    def forward(self, x):\n","        down = self.conv(x)\n","        p = self.pool(down)\n","        return down, p\n","\n","class UpSample(nn.Module):\n","    def __init__(self, in_channels, out_channels):\n","        super().__init__()\n","        self.up = nn.ConvTranspose2d(in_channels, out_channels, kernel_size=2, stride=2)\n","        self.conv = DoubleConv(in_channels=out_channels*2, out_channels=out_channels)\n","\n","    def forward(self, y1, y2):\n","        y1 = self.up(y1)\n","        # making sure sizes match\n","        diff_1 = y2.size()[2] - y1.size()[2]\n","        diff_2 = y2.size()[3] - y1.size()[3]\n","        y1 = F.pad(y1, [diff_1 // 2, diff_1 - diff_1 // 2, diff_2 // 2, diff_2 - diff_2 // 2]) # padding if sized do not match\n","        y = torch.cat([y1, y2], dim = 1)\n","        return self.conv(y)"]},{"cell_type":"code","execution_count":14,"id":"687d4c69","metadata":{"execution":{"iopub.execute_input":"2025-08-24T16:32:54.321643Z","iopub.status.busy":"2025-08-24T16:32:54.321419Z","iopub.status.idle":"2025-08-24T16:32:54.325716Z","shell.execute_reply":"2025-08-24T16:32:54.32502Z"},"papermill":{"duration":0.015858,"end_time":"2025-08-24T16:32:54.326742","exception":false,"start_time":"2025-08-24T16:32:54.310884","status":"completed"},"tags":[]},"outputs":[],"source":["# function calculating the dice coefficient with the optial threhold for the data\n","def dice_coefficient(p, t, threshold, epsilon=1e-07):\n","    p_copy = p.clone()\n","    p_copy[p_copy < threshold] = 0\n","    p_copy[p_copy > threshold] = 1\n","    intersection = abs(torch.sum(p_copy * t))\n","    union = abs(torch.sum(p_copy) + torch.sum(t))\n","    dice = (2 * intersection + epsilon) / (union + epsilon)\n","    return dice"]},{"cell_type":"code","execution_count":15,"id":"9f28be06","metadata":{"execution":{"iopub.execute_input":"2025-08-24T16:32:54.34894Z","iopub.status.busy":"2025-08-24T16:32:54.348728Z","iopub.status.idle":"2025-08-24T16:32:54.353817Z","shell.execute_reply":"2025-08-24T16:32:54.353117Z"},"papermill":{"duration":0.01821,"end_time":"2025-08-24T16:32:54.35505","exception":false,"start_time":"2025-08-24T16:32:54.33684","status":"completed"},"tags":[]},"outputs":[],"source":["# function that checks for the best dice coefficient\n","def find_best_threshold(model, val_loader, device):\n","    thresholds = np.linspace(0.1, 0.9, 50) #try smaller steps to get best dice coefficient\n","    model.eval()\n","    best_t, best_dice = 0.0, 0.0 # from best_t 0.5 to see if it actually overwrites anything\n","    with torch.no_grad():\n","        for t in thresholds:\n","            dices = []\n","            for imgs, masks in val_loader:\n","                imgs, masks = imgs.to(device), masks.to(device)\n","                preds = model(imgs)\n","                dice = dice_coefficient(torch.sigmoid(preds), masks, threshold = t).item()\n","                dices.append(dice)\n","            mean_dice = np.mean(dices)\n","            if mean_dice > best_dice:\n","                best_dice, best_t = mean_dice, t\n","\n","    print(f\"Best threshold: {best_t:.2f} with Dice {best_dice:.4f}\")\n","    return best_t"]},{"cell_type":"code","execution_count":16,"id":"f358c833","metadata":{"execution":{"iopub.execute_input":"2025-08-24T16:32:54.375599Z","iopub.status.busy":"2025-08-24T16:32:54.375382Z","iopub.status.idle":"2025-08-24T16:32:54.380892Z","shell.execute_reply":"2025-08-24T16:32:54.380216Z"},"papermill":{"duration":0.01713,"end_time":"2025-08-24T16:32:54.381893","exception":false,"start_time":"2025-08-24T16:32:54.364763","status":"completed"},"tags":[]},"outputs":[],"source":["# function that calculates Dice loss and weighted sum of Dice and BCE loss \n","class DiceLoss(nn.Module):\n","    def __init__(self, smooth=1.0):\n","        super().__init__()\n","        self.smooth = smooth\n","\n","    def forward(self, p, t):\n","        p = p.view(-1)\n","        t = t.view(-1)\n","        intersection = (p * t).sum()\n","        return 1 - (2 * intersection + self.smooth) / (p.sum() + t.sum() + self.smooth)\n","\n","class CombinedLoss(nn.Module):\n","    def __init__(self, dice_weight=w_dc, bce_weight=w_bce):\n","        super().__init__()\n","        self.dice = DiceLoss()\n","        self.bce = nn.BCEWithLogitsLoss(pos_weight=torch.tensor([5.0]).to(DEVICE)) ### weights for minority class\n","        self.dw = dice_weight\n","        self.bw = bce_weight\n","\n","    def forward(self, p, t):\n","        return self.dw * self.dice(p, t) + self.bw * self.bce(p, t)"]},{"cell_type":"code","execution_count":17,"id":"7ef2b77d","metadata":{"execution":{"iopub.execute_input":"2025-08-24T16:32:54.402673Z","iopub.status.busy":"2025-08-24T16:32:54.402463Z","iopub.status.idle":"2025-08-24T16:32:54.406301Z","shell.execute_reply":"2025-08-24T16:32:54.405781Z"},"papermill":{"duration":0.015488,"end_time":"2025-08-24T16:32:54.407366","exception":false,"start_time":"2025-08-24T16:32:54.391878","status":"completed"},"tags":[]},"outputs":[],"source":["# function calculating IoU\n","def iou_coefficient(p, t, epsilon=1e-8):\n","    p_copy = p.clone()\n","\n","    p_copy[p_copy  < 0.5] = 0\n","    p_copy[p_copy  > 0.5] = 1\n","\n","    intersection = abs(torch.sum(p_copy * t))\n","    union = abs(torch.sum(p_copy) + torch.sum(t))\n","    iou = (intersection + epsilon) / ((union + epsilon)-intersection)\n","    \n","    return iou"]},{"cell_type":"code","execution_count":18,"id":"084b9a4d","metadata":{"execution":{"iopub.execute_input":"2025-08-24T16:32:54.427866Z","iopub.status.busy":"2025-08-24T16:32:54.427658Z","iopub.status.idle":"2025-08-24T16:32:54.431968Z","shell.execute_reply":"2025-08-24T16:32:54.431478Z"},"papermill":{"duration":0.015744,"end_time":"2025-08-24T16:32:54.433098","exception":false,"start_time":"2025-08-24T16:32:54.417354","status":"completed"},"tags":[]},"outputs":[],"source":["# function calculating sensitivity, specificity, precision and f1-score\n","def compute_classification_metrics(pred, target, epsilon=1e-07):\n","    pred_bin = (pred >= 0.5).float()\n","    y_true = target.detach().cpu().numpy().flatten()\n","    y_pred = pred_bin.detach().cpu().numpy().flatten()\n","    tn, fp, fn, tp = confusion_matrix(\n","        y_true.flatten(), y_pred.flatten(), labels=[0,1]\n","    ).ravel()\n","    sensitivity = tp / (tp + fn + epsilon)\n","    specificity = tn / (tn + fp + epsilon)\n","    precision   = tp / (tp + fp + epsilon)\n","    f1 = 2 * (precision * sensitivity) / (precision + sensitivity + epsilon)\n","    return sensitivity, specificity, precision, f1"]},{"cell_type":"code","execution_count":19,"id":"929fc603","metadata":{"execution":{"iopub.execute_input":"2025-08-24T16:32:54.454562Z","iopub.status.busy":"2025-08-24T16:32:54.454359Z","iopub.status.idle":"2025-08-24T16:32:54.459708Z","shell.execute_reply":"2025-08-24T16:32:54.459189Z"},"papermill":{"duration":0.017537,"end_time":"2025-08-24T16:32:54.460781","exception":false,"start_time":"2025-08-24T16:32:54.443244","status":"completed"},"tags":[]},"outputs":[],"source":["# evaluation after each epoch. Includes calculation of overall loss, Dice, IoU, sensitivity, specificity, precision and f1-score\n","def eval_epoch_with_metrics(model, loader, criterion, device, bdt):\n","    model.eval()\n","    total_loss = 0\n","    total_dice = 0\n","    total_iou = 0\n","    #total_sens = 0\n","    #total_sepc = 0\n","    #total_prec = 0\n","    #total_f1 = 0\n","    all_preds = []\n","    all_labels = []\n","\n","    with torch.no_grad():\n","        for X, y in loader:\n","            X, y = X.to(device), y.to(device)\n","            pred = model(X)\n","            total_loss += criterion(pred, y).item()\n","            total_dice += dice_coefficient(pred, y, bdt).item()\n","            total_iou += iou_coefficient(pred, y).item()\n","            #sensitivity_temp, specificity_temp, precision_temp, f1_temp = compute_classification_metrics(pred, y)\n","            #total_sens += sensitivity_temp\n","            #total_sepc += specificity_temp\n","            #total_prec += precision_temp\n","            #total_f1 += f1_temp\n","\n","            # Save predictions and labels for AUC calculation later\n","            all_preds.extend(pred.view(-1).cpu().numpy())\n","            all_labels.extend(y.view(-1).cpu().numpy())\n","\n","    # Calculate pixel-wise ROC AUC\n","    from sklearn.metrics import roc_auc_score\n","    auc = roc_auc_score(all_labels, all_preds)\n","\n","    n = len(loader)\n","    return total_loss / n, total_dice / n, total_iou / n, auc #, total_sens / n, total_sepc / n, total_prec / n, total_f1 / n"]},{"cell_type":"code","execution_count":20,"id":"45f75038","metadata":{"execution":{"iopub.execute_input":"2025-08-24T16:32:54.481686Z","iopub.status.busy":"2025-08-24T16:32:54.481469Z","iopub.status.idle":"2025-08-24T16:32:54.485844Z","shell.execute_reply":"2025-08-24T16:32:54.485129Z"},"papermill":{"duration":0.016021,"end_time":"2025-08-24T16:32:54.486865","exception":false,"start_time":"2025-08-24T16:32:54.470844","status":"completed"},"tags":[]},"outputs":[],"source":["# function for training our model\n","def train_epoch(model, loader, criterion, optimizer, device):\n","    model.train()\n","    total = 0\n","    for X, y in tqdm(loader, desc=\"Train\", leave=False):\n","        X, y = X.to(device), y.to(device)\n","        pred = model(X)\n","        loss = criterion(pred, y)\n","        optimizer.zero_grad()\n","        loss.backward()\n","        optimizer.step()\n","        total += loss.item()\n","    return total / len(loader)\n"]},{"cell_type":"code","execution_count":21,"id":"bd1d75d4","metadata":{"execution":{"iopub.execute_input":"2025-08-24T16:32:54.507604Z","iopub.status.busy":"2025-08-24T16:32:54.507412Z","iopub.status.idle":"2025-08-24T16:32:58.16227Z","shell.execute_reply":"2025-08-24T16:32:58.161305Z"},"papermill":{"duration